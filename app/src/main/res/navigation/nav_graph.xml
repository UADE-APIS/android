<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/auth_nav_graph">

    <include app:graph="@navigation/auth_nav_graph" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.xplorenow.home.HomeFragment"
        android:label="Explorar"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_myBookings"
            app:destination="@id/myBookingsFragment" />

        <action
            android:id="@+id/action_home_to_createBooking"
            app:destination="@id/createBookingFragment" />

        <action
            android:id="@+id/action_home_to_authStart"
            app:destination="@id/authStartFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />

        <action
            android:id="@+id/action_home_to_history"
            app:destination="@id/historyFragment" />

        <action
            android:id="@+id/action_home_to_favorites"
            app:destination="@id/favoritesFragment" />

        <action
            android:id="@+id/action_home_to_news"
            app:destination="@id/newsFragment" />

        <action
            android:id="@+id/action_home_to_activityDetail"
            app:destination="@id/activityDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/myBookingsFragment"
        android:name="com.example.xplorenow.bookings.MyBookingsFragment"
        android:label="Mis Reservas"
        tools:layout="@layout/fragment_my_bookings">

        <action
            android:id="@+id/action_myBookings_to_activityDetail"
            app:destination="@id/activityDetailFragment" />

        <action
            android:id="@+id/action_myBookings_to_bookingDetail"
            app:destination="@id/bookingDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/createBookingFragment"
        android:name="com.example.xplorenow.bookings.CreateBookingFragment"
        android:label="Crear Reserva"
        tools:layout="@layout/fragment_create_booking">

        <argument
            android:name="activityId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.xplorenow.profile.ProfileFragment"
        android:label="Mi Perfil"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />

        <action
            android:id="@+id/action_profileFragment_to_transactionsFragment"
            app:destination="@id/transactionsFragment" />
    </fragment>

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.example.xplorenow.profile.ChangePasswordFragment"
        android:label="Cambiar Contraseña"
        tools:layout="@layout/fragment_change_password" />

    <fragment
        android:id="@+id/activityDetailFragment"
        android:name="com.example.xplorenow.detail.ActivityDetailFragment"
        android:label="Detalle"
        tools:layout="@layout/fragment_activity_detail">

        <argument
            android:name="activityId"
            app:argType="integer"
            android:defaultValue="-1" />

        <action
            android:id="@+id/action_activityDetailFragment_to_createBookingFragment"
            app:destination="@id/createBookingFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.xplorenow.history.HistoryFragment"
        android:label="Mi Historial"
        tools:layout="@layout/fragment_history">

        <action
            android:id="@+id/action_history_to_activityDetail"
            app:destination="@id/activityDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.xplorenow.favorites.FavoritesFragment"
        android:label="Favoritos"
        tools:layout="@layout/fragment_favorites">

        <action
            android:id="@+id/action_favorites_to_activityDetail"
            app:destination="@id/activityDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/newsFragment"
        android:name="com.example.xplorenow.news.NewsFragment"
        android:label="Noticias"
        tools:layout="@layout/fragment_news">

        <action
            android:id="@+id/action_news_to_newsDetail"
            app:destination="@id/newsDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/newsDetailFragment"
        android:name="com.example.xplorenow.news.NewsDetailFragment"
        android:label="Noticia"
        tools:layout="@layout/fragment_news_detail">

        <argument
            android:name="newsId"
            app:argType="integer"
            android:defaultValue="-1" />

        <action
            android:id="@+id/action_newsDetail_to_activityDetail"
            app:destination="@id/activityDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/transactionsFragment"
        android:name="com.example.xplorenow.transactions.TransactionsFragment"
        android:label="Mis Transacciones"
        tools:layout="@layout/fragment_transactions">

        <action
            android:id="@+id/action_transactions_to_transactionDetail"
            app:destination="@id/transactionDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/transactionDetailFragment"
        android:name="com.example.xplorenow.transactions.TransactionDetailFragment"
        android:label="Detalle de Transacción"
        tools:layout="@layout/fragment_transaction_detail">

        <argument
            android:name="transactionId"
            app:argType="string" />

        <action
            android:id="@+id/action_transactionDetail_to_bookingDetail"
            app:destination="@id/bookingDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingDetailFragment"
        android:name="com.example.xplorenow.bookings.BookingDetailFragment"
        android:label="Detalle de Reserva"
        tools:layout="@layout/fragment_booking_detail">

        <argument
            android:name="booking"
            app:argType="com.example.xplorenow.data.model.Booking" />

        <action
            android:id="@+id/action_bookingDetail_to_transactionDetail"
            app:destination="@id/transactionDetailFragment" />
    </fragment>

</navigation>
